            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"batchId\": \"BATCH_ID\", \"teacherId\": \"TEACHER_ID\", \"subject\": \"Physics\", \"date\": \"2026-09-25\", \"startTime\": \"10:00\", \"endTime\": \"11:00\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions"
          ]
        }
      }
    },
