          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Demo Teacher\", \"email\": \"teacher@example.com\", \"mobile\": \"8888888888\", \"subjects\": [\"Physics\"], \"batchIds\": []}"
        },
        "url": {
          "raw": "{{baseUrl}}/teachers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "teachers"
          ]
        }
      }
    },
    {
      "name": "Create Batch",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"JEE Morning\", \"course\": \"JEE\", \"subjects\": [\"Physics\", \"Maths\"], \"teacherIds\": []}"
        },
        "url": {
          "raw": "{{baseUrl}}/batches",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "batches"
          ]
        }
      }
    },
