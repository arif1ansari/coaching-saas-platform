      "name": "Mark Attendance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"students\": [{\"studentId\": \"STUDENT_ID\", \"status\": \"PRESENT\"}]}"
        },
        "url": {
          "raw": "{{baseUrl}}/attendance/{{sessionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "attendance",
            "{{sessionId}}"
          ]
        }
      }
    },
    {
      "name": "Create Fee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"studentId\": \"STUDENT_ID\", \"totalAmount\": 30000, \"installments\": [{\"name\": \"Installment 1\", \"amount\": 10000, \"dueDate\": \"2026-10-01\"}, {\"name\": \"Installment 2\", \"amount\": 10000, \"dueDate\": \"2026-11-01\"}, {\"name\": \"Installment 3\", \"amount\": 10000, \"dueDate\": \"2026-12-01\"}]}"
        },
        "url": {
          "raw": "{{baseUrl}}/fees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "fees"
          ]
        }
      }
    },
    {
      "name": "Record Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"amount\": 10000, \"paymentDate\": \"2026-09-25\", \"mode\": \"CASH\", \"reference\": \"CASH-001\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/fees/{{feeId}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "fees",
            "{{feeId}}",
            "payments"
          ]
        }
      }
    },
    {
      "name": "Create Test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Physics Test 1\", \"batchId\": \"BATCH_ID\", \"subject\": \"Physics\", \"testDate\": \"2026-10-05\", \"totalMarks\": 100}"
        },
        "url": {
          "raw": "{{baseUrl}}/tests",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tests"
          ]
        }
      }
    },
    {
      "name": "Submit Results",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"results\": [{\"studentId\": \"STUDENT_ID\", \"marks\": 82}]}"
        },
        "url": {
          "raw": "{{baseUrl}}/tests/{{testId}}/results",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tests",
            "{{testId}}",
            "results"
          ]
        }
      }
