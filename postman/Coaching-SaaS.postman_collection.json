    {
      "name": "Change Password",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\"currentPassword\": \"Password@123\", \"newPassword\": \"NewPassword@123\"}"},
        "url": {"raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth", "change-password"]}
      }
    },
    {
      "name": "Create Subject",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\"name\": \"Mathematics\", \"code\": \"MATH\"}"},
        "url": {"raw": "{{baseUrl}}/subjects", "host": ["{{baseUrl}}"], "path": ["subjects"]}
      }
    },
    {
      "name": "Teacher Dashboard",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {"raw": "{{baseUrl}}/teacher/dashboard", "host": ["{{baseUrl}}"], "path": ["teacher", "dashboard"]}
      }
    },
    {
      "name": "Search Students",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {"raw": "{{baseUrl}}/students?search=rahul&page=0&size=20", "host": ["{{baseUrl}}"], "path": ["students"], "query": [{"key":"search","value":"rahul"},{"key":"page","value":"0"},{"key":"size","value":"20"}]}
      }
    },
    {
      "name": "Super Admin Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/super-admin/dashboard",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "super-admin",
            "dashboard"
          ]
        }
      }
    }
